# Domain Caddy gets an HTTPS certificate for (DNS A record must point at this VPS).
CMS_DOMAIN=api.kazkioti.kz
# Site endpoint(s) that refresh cached pages after an edit, comma-separated.
SITE_REVALIDATE_URLS=https://kazkioti.kz/api/revalidate
# Same value as REVALIDATE_SECRET on the site (Vercel). Generate: openssl rand -hex 32
REVALIDATE_SECRET=
